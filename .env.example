# Copy to ../.env (one level above the repo) or adjust agent.py if you prefer a different location.

# LLM cleanup
LLM_PROVIDER=xai
LLM_MODEL=grok-3
# Max output tokens for the cleanup pass. Start at 300000 and tune down only if needed.
LLM_MAX_TOKENS=300000

# xAI / Grok
XAI_API_KEY=your_xai_api_key_here

# Optional alternate providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# Email delivery
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_smtp_password_here
EMAIL_FROM=your_email@example.com
TRANSCRIPT_RECIPIENTS=recipient@example.com,other@example.com
TEST_RUN_RECIPIENTS=recipient@example.com

# Optional runtime overrides
FORCE_REPROCESS=false
